{
  "title": "LLMOps Control Plane",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "rate(llmops_requests_total[5m])", "legendFormat": "{{provider}}"}]
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(llmops_request_latency_seconds_bucket[5m])) by (le, provider))", "legendFormat": "{{provider}}"}]
    },
    {
      "type": "timeseries",
      "title": "Estimated cost",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "rate(llmops_estimated_cost_usd_total[15m])", "legendFormat": "{{provider}} / {{model}}"}]
    },
    {
      "type": "timeseries",
      "title": "Evaluation status",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "rate(llmops_evaluations_total[5m])", "legendFormat": "{{status}}"}]
    }
  ]
}